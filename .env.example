# PostgreSQL connection used only on the server.
DATABASE_URL=postgresql://carteazilei:carteazilei_dev@localhost:5432/carteazilei

# Used only by docker-compose.dev.yml. Choose different production credentials.
POSTGRES_USER=carteazilei
POSTGRES_PASSWORD=carteazilei_dev
POSTGRES_DB=carteazilei

# Generate a strong value of at least 32 characters for every environment.
AUTH_SECRET=replace-with-a-strong-random-secret-of-at-least-32-characters
NEXTAUTH_URL=http://localhost:3000

# One-off administrator bootstrap. Keep false except during the explicit CLI run.
ALLOW_ADMIN_BOOTSTRAP=false
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Public canonical origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Include a lightweight database probe in GET /api/health.
HEALTHCHECK_DATABASE=false

# Minimum number of eligible, editorially explained books for an indexable SEO hub.
SEO_HUB_MINIMUM_BOOKS=5

# Optional real inbox displayed on the public contact page. Never use a placeholder in production.
PUBLIC_CONTACT_EMAIL=

# Media storage. Local is the simplest option for a single Coolify instance.
MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT=.local-storage/media

# Optional S3-compatible storage. Required only with MEDIA_STORAGE_DRIVER=s3.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Optional origin/CDN used later to render public media, without trailing slash.
S3_PUBLIC_BASE_URL=
